# ── $MOONBAG backend configuration ──────────────────────────────────────────
# Copy to .env and fill in. The server boots fine with everything left blank:
# it runs in DRY_RUN mode and the site shows simulated data.

# Solana RPC. The public endpoint works for testing; use a paid RPC
# (Helius/Triton/QuickNode) in production — the scanner parses transactions.
RPC_URL=https://api.mainnet-beta.solana.com

# The $MOONBAG mint address (from pump.fun after launch).
TOKEN_MINT=

# Vault wallet secret key: base58 string or JSON byte array.
# ⚠️  This wallet must be the pump.fun CREATOR wallet (it claims creator fees)
#     and it is where holders send tokens to lock. Guard this key.
VAULT_SECRET_KEY=

# Reward cadence (ms). The thesis: every 2 minutes.
DISTRIBUTION_INTERVAL_MS=120000

# Skip a round if the pot is below this many SOL.
MIN_DISTRIBUTION_SOL=0.01

# SOL held back in the vault for tx fees — never distributed.
RESERVE_SOL=0.05

# Payouts below this many lamports roll over to the next round.
MIN_PAYOUT_LAMPORTS=100000

# Safety switch. Keep true until mint + vault are configured and verified.
DRY_RUN=true

PORT=3000
