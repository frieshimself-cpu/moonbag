# ── $MOONBAG backend configuration ──────────────────────────────────────────
# Copy to .env and fill in. The server boots fine with everything left blank:
# it runs in DRY_RUN mode and the site shows simulated data.

# Solana RPC. The public endpoint works for testing; use a paid RPC
# (Helius/Triton/QuickNode) in production — the scanner parses transactions.
RPC_URL=https://api.mainnet-beta.solana.com

# The $MOONBAG mint address (from pump.fun after launch).
TOKEN_MINT=HwmZZJNLRtKeChQ62TSdNzVxuDiKac56L8rT9wxrpump

# Vault wallet secret key: base58 string or JSON byte array. This is where
# holders send tokens to lock and where payouts come from. Guard this key —
# generate it with `npm run setup` and never let it leave this machine.
# If CREATOR_SECRET_KEY is empty, this wallet must ALSO be the pump.fun
# creator wallet (it then claims creator fees itself).
VAULT_SECRET_KEY=

# OPTIONAL: separate pump.fun creator wallet key. Use when the token was
# created from a different wallet than the vault — e.g. if the creator key
# was ever exposed anywhere (chat, screenshot, another machine). Fees are
# claimed with it and swept to the clean vault every cycle, so it never
# holds more than ~a minute of fees and never touches locked tokens.
CREATOR_SECRET_KEY=

# Reward cadence (ms). Every 5 minutes.
DISTRIBUTION_INTERVAL_MS=300000

# How often accrued creator fees are claimed into the vault (ms).
# Independent of the distribution cadence; each claim is a small on-chain tx.
CLAIM_INTERVAL_MS=60000

# Minimum lock duration. Each deposit can be unlocked this many hours after
# it lands; unlocks consume oldest deposits first.
MIN_LOCK_HOURS=24

# Skip a round if the pot is below this many SOL.
MIN_DISTRIBUTION_SOL=0.01

# SOL held back in the vault for tx fees — never distributed.
RESERVE_SOL=0.05

# Payouts below this many lamports roll over to the next round.
MIN_PAYOUT_LAMPORTS=100000

# Safety switch. Keep true until mint + vault are configured and verified.
DRY_RUN=true

PORT=3000
