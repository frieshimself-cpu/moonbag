{
  "name": "moonbag-server",
  "version": "1.0.0",
  "description": "MOONBAG backend: tracks locked supply and distributes pump.fun creator rewards to lockers every 2 minutes",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "DB_PATH=test-suite.db tsx src/test-suite.ts && rm -f test-suite.db*",
    "test:round": "tsx src/test-round.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@solana/web3.js": "^1.95.8",
    "better-sqlite3": "^11.10.0",
    "bs58": "^6.0.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
